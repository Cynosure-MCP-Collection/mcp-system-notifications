{
    "name": "@cynosure-mcp/system-notifications",
    "mcpName": "io.github.andreasjhagen/system-notifications",
    "version": "1.0.0",
    "description": "MCP server for sending local system notifications",
    "type": "module",
    "main": "dist/index.js",
    "bin": {
        "system-notifications": "dist/index.js"
    },
