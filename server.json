{
    "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
    "name": "io.github.andreasjhagen/system-notifications",
    "description": "MCP server for sending local system notifications",
    "version": "1.0.2",
    "icons": [
        {
            "src": "https://unpkg.com/@cynosure-mcp/system-notifications@1.0.2/icon.png",
            "mimeType": "image/png"
        }
    ],
    "packages": [
        {
            "registryType": "npm",
            "identifier": "@cynosure-mcp/system-notifications",
            "version": "1.0.2",
            "transport": {
                "type": "stdio"
            },
            "environmentVariables": []
        }
    ],
    "repository": {
        "url": "https://github.com/Cynosure-MCP-Collection/mcp-system-notifications",
        "source": "github"
    }
}
